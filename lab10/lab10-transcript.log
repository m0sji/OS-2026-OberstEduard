p = "kernel/syscall.c"
lines = open(p).read().splitlines(keepends=True)

# a) tabelul de nume, chiar deasupra functiei syscall()
idx = next(i for i,l in enumerate(lines) if l.strip() == "syscall(void)")
insert_at = idx-1 if lines[idx-1].strip() == "void" else idx
block = '''static char *syscallnames[] = {
  [SYS_fork]   "fork",   [SYS_exit]   "exit",   [SYS_wait]  "wait",
  [SYS_pipe]   "pipe",   [SYS_read]   "read",   [SYS_kill]  "kill",
  [SYS_exec]   "exec",   [SYS_fstat]  "fstat",  [SYS_chdir] "chdir",
  [SYS_dup]    "dup",    [SYS_getpid] "getpid", [SYS_sbrk]  "sbrk",
  [SYS_pause]  "pause",  [SYS_uptime] "uptime", [SYS_open]  "open",
  [SYS_write]  "write",  [SYS_mknod]  "mknod",  [SYS_unlink]"unlink",
  [SYS_link]   "link",   [SYS_mkdir]  "mkdir",  [SYS_close] "close",
  [SYS_sync]   "sync",   [SYS_trace]  "trace",
};

'''
lines[insert_at:insert_at] = [block]

# b) printul, dupa linia care apeleaza syscall-ul
out = []
for line in lines:
    out.append(line)
    if "p->trapframe->a0 = syscalls[num]();" in line:
        out.append("    if ((p->trace_mask >> num) & 1) // new\n")
        out.append('      printk("%d: syscall %s -> %ld\\n", // new\n')
        out.append("             p->pid, syscallnames[num], p->trapframe->a0);\n")

open(p, "w").writelines(out)
print("OK syscall.c names+print")
