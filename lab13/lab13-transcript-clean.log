//msem_trydown(id):AlikeAsem_down,AbutAneverAsleeps:A-1AifAthe value is 0.
uint64
sys_sem_trydown(void)
{
  int id;
  argint(0, &id);
  if (id < 0 || id >= NSEM)
    return -1;
  struct sem *s = &sems[id];

  acquire(&s->lock);
  if (s->value == 0) {
    release(&s->lock);
    return -1;
  }
  s->value--;
  release(&s->lock);
  return 0;
}
EOF
