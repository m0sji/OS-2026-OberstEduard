diff --git a/user/mix.c b/user/mix.c
new file mode 100644
index 0000000..bb9aa30
--- /dev/null
+++ b/user/mix.c
@@ -0,0 +1,32 @@
+// mix.c: two processes print five lines each, one letter per write().
+//   mix        no lock: the letters of the two processes can mix
+//   mix lock   semaphore 3 used as a lock: every line stays whole
+#include "kernel/types.h"
+#include "user/user.h"
+
+void
+lines(char *s, int uselock)
+{
+  for (int k = 0; k < 5; k++) {
+    if (uselock)
+      sem_down(3);
+    for (char *p = s; *p; p++)
+      write(1, p, 1);
+    if (uselock)
+      sem_up(3);
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  int uselock = (argc > 1);
+  sem_init(3, 1);
+  if (fork() == 0) {
+    lines("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n", uselock);
+    exit(0);
+  }
+  lines("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n", uselock);
+  wait(0);
+  exit(0);
+}
diff --git a/user/semtest.c b/user/semtest.c
new file mode 100644
index 0000000..0e2f1f8
--- /dev/null
+++ b/user/semtest.c
@@ -0,0 +1,39 @@
+// semtest.c: two tests for the kernel semaphores (Lab 13).
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  // Test 1: order. Semaphore 0 starts at 0, so the child must wait.
+  sem_init(0, 0);
+  if (fork() == 0) {
+    sem_down(0);
+    printf("child: I ran after the parent\n");
+    exit(0);
+  }
+  pause(10);
+  printf("parent: done, I let the child go\n");
+  sem_up(0);
+  wait(0);
+
+  // Test 2: ping-pong. Semaphore 1 = ping's turn, semaphore 2 = pong's turn.
+  sem_init(1, 1);
+  sem_init(2, 0);
+  if (fork() == 0) {
+    for (int i = 1; i <= 3; i++) {
+      sem_down(2);
+      printf("  pong %d\n", i);
+      sem_up(1);
+    }
+    exit(0);
+  }
+  for (int i = 1; i <= 3; i++) {
+    sem_down(1);
+    printf("ping %d\n", i);
+    sem_up(2);
+  }
+  wait(0);
+  printf("semtest: OK\n");
+  exit(0);
+}
diff --git a/user/trytest.c b/user/trytest.c
new file mode 100644
index 0000000..80b0bbe
--- /dev/null
+++ b/user/trytest.c
@@ -0,0 +1,14 @@
+// trytest.c: sem_trydown never sleeps, it answers 0 or -1 at once.
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  sem_init(4, 1);
+  printf("first try:  %d\n", sem_trydown(4));   // 0: the value was 1
+  printf("second try: %d\n", sem_trydown(4));   // -1: the value is 0, no sleep
+  sem_up(4);
+  printf("after up:   %d\n", sem_trydown(4));   // 0 again
+  exit(0);
+}
