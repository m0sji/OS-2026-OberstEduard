0;capziro@capziro-3: ~/xv6-riscv01;32mcapziro@capziro-300m:01;34m~/xv6-riscv00m$(cat >r~/ins.py.<< 'EOF'7m7m'27mAAAAAAAAAAAAAAAAAAAAAAAAA
#!/usr/bin/env python3
# ins.py FILE ANCHOR_REGEX TEXT
# Inserts TEXT after the first line that matches ANCHOR_REGEX.
# Does nothing if TEXT is already in FILE.
import re, sys
path, anchor, text = sys.argv[1], sys.argv[2], sys.argv[3]
text = text.replace('\\n', '\n').replace('\\t', '\t')
if not text.endswith('\n'):
    text += '\n'
src = open(path).read()
if text in src:
    print("ALREADY THERE:", path)
    sys.exit(0)
lines = src.splitlines(keepends=True)
for i, line in enumerate(lines):
    if re.search(anchor, line):
	lines.insert(i + 1, text)
	open(path, 'w').write(''.join(lines))
	print("INSERTED after line", i + 1, "of", path)
	sys.exit(0)
print("ANCHOR NOT FOUND:", anchor)
sys.exit(1)
EOF
python3 -c 'import ast,os; ast.parse(open(os.path.expanduser("~/ins.py")).read()); print("ins.py OK")'
