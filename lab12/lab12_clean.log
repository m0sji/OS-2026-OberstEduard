/* readers.c - readers and writers with two semaphores.
 *   Many readers may read together; a writer must be alone.
 * Build: gcc -Wall -pthread -o readers readers.c
 */
#include <stdio.h>
#include <unistd.h>
#include <pthread.h>
#include <semaphore.h>

#define READERS 3
7m#define WRITERS 227m

7mint value = 0;		  /* the shared data */27m
7mint readers = 0;		  /* how many are reading now */27m
7msem_t rlock;			  /* protects the counter readers */27m
7msem_t room;			  /* 1 = the room is free for a writer */27m

7mvoid *reader(void *arg) {27m
7m    long id = (long)arg;27m
7m    sem_wait(&rlock);27m
7m    if (++readers == 1)	  /* the first reader in locks out the writers */27m
7m	  sem_wait(&room);27m
7m    sem_post(&rlock);27m

7m    printf("reader %ld reads %d   (readers inside: %d)\n", id, value, readers);27m
7m    usleep(200000);27m

7m    sem_wait(&rlock);27m
7m    if (--readers == 0)	  /* the last reader out lets the writers in */27m
7m	  sem_post(&room);27m
7m    sem_post(&rlock);27m
7m    return NULL;27m
7m}27m

7mvoid *writer(void *arg) {27m
7m    long id = (long)arg;27m
7m    sem_wait(&room);		  /* alone in the room */27m
7m    value += 10;27m
7m    printf("writer %ld writes %d (alone)\n", id, value);27m
7m    usleep(200000);27m
7m    sem_post(&room);27m
7m    return NULL;27m
7m}27m

7mint main(void) {27m
7m    sem_init(&rlock, 0, 1);27m
7m    sem_init(&room, 0, 1);27m
7m    pthread_t r[READERS], w[WRITERS];27m
7m    pthread_create(&w[0], NULL, writer, (void *)1L);27m
7m    for (long i = 0; i < READERS; i++)27m
7m	  pthread_create(&r[i], NULL, reader, (void *)(i + 1));27m
7m    pthread_create(&w[1], NULL, writer, (void *)2L);27m
7m    for (int i = 0; i < READERS; i++) pthread_join(r[i], NULL);27m
7m    for (int i = 0; i < WRITERS; i++) pthread_join(w[i], NULL);27m
7m    return 0;27m
7m}27m
#definemWRITERSA2AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

int value = 0;			/* the shared data */
int readers = 0;		/* how many are reading now */
sem_t rlock;			/* protects the counter readers */
sem_t room;			/* 1 = the room is free for a writer */

void *reader(void *arg) {
    long id = (long)arg;
    sem_wait(&rlock);
    if (++readers == 1)		/* the first reader in locks out the writers */
	sem_wait(&room);
    sem_post(&rlock);

    printf("reader %ld reads %d	  (readers inside: %d)\n", id, value, readers);
    usleep(200000);

    sem_wait(&rlock);
    if (--readers == 0)		/* the last reader out lets the writers in */
	sem_post(&room);
    sem_post(&rlock);
    return NULL;
}

void *writer(void *arg) {
    long id = (long)arg;
    sem_wait(&room);		/* alone in the room */
    value += 10;
    printf("writer %ld writes %d (alone)\n", id, value);
    usleep(200000);
    sem_post(&room);
    return NULL;
}

int main(void) {
    sem_init(&rlock, 0, 1);
    sem_init(&room, 0, 1);
    pthread_t r[READERS], w[WRITERS];
    pthread_create(&w[0], NULL, writer, (void *)1L);
    for (long i = 0; i < READERS; i++)
	pthread_create(&r[i], NULL, reader, (void *)(i + 1));
    pthread_create(&w[1], NULL, writer, (void *)2L);
    for (int i = 0; i < READERS; i++) pthread_join(r[i], NULL);
    for (int i = 0; i < WRITERS; i++) pthread_join(w[i], NULL);
    return 0;
