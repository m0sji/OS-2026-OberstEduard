// sem.c: counting semaphores inside the xv6 kernel (Lab 13).
// A small table of NSEM semaphores, shared by every process.
// Each one is a number plus a spinlock that protects the number.

#include "types.h"
#include "riscv.h"
#include "defs.h"
#include "param.h"
#include "spinlock.h"
#include "proc.h"

#define NSEM 8

struct sem {
  struct spinlock lock;	      // a zeroed spinlock is a free spinlock
  int value;		      // how many may still pass
};

static struct sem sems[NSEM];

// sem_init(id, value): give semaphore id its start value.
uint64
sys_sem_init(void)
{
  int id, value;
  argint(0, &id);
  argint(1, &value);
  if (id < 0 || id >= NSEM || value < 0)
    return -1;
  acquire(&sems[id].lock);
  sems[id].value = value;
7m  release(&sems[id].lock);27m
7m  return 0;27m
7m}27m

7m// sem_down(id): take one unit; if there is none, sleep until there is.27m
7muint6427m
7msys_sem_down(void)27m
7m{27m
7m  int id;27m
7m  argint(0, &id);27m
7m  if (id < 0 || id >= NSEM)27m
7m    return -1;27m
7m  struct sem *s = &sems[id];27m

7m  acquire(&s->lock);27m
7m  while (s->value == 0) {27m
7m    sleep_prepare(s);	      // I will sleep on the address of s27m
7m    release(&s->lock);      // never sleep holding a spinlock27m
7m    sleep();		      // returns at once if sem_up came in between27m
7m    acquire(&s->lock);27m
7m    if (killed(myproc())) { // kill must still work on a waiting process27m
7m	release(&s->lock);27m
7m	return -1;27m
7m    }27m
7m  }27m
7m  s->value--;27m
7m  release(&s->lock);27m
7m  return 0;27m
7m}27m

7m// sem_up(id): give one unit back and wake whoever sleeps on s.27m
7muint6427m
7msys_sem_up(void)27m
7m{27m
7m  int id;27m
7m  argint(0, &id);27m
7m  if (id < 0 || id >= NSEM)27m
7m    return -1;27m
7m  struct sem *s = &sems[id];27m

7m  acquire(&s->lock);27m
7m  s->value++;27m
7m  wakeup(s);27m
7m  release(&s->lock);27m
7m  return 0;27m
7m}27m
7mrelease(&sems[id].lock);AAAAAAAAAAAAAAAAAAAAAAAAAAAA
  return 0;
}

// sem_down(id): take one unit; if there is none, sleep until there is.
uint64
sys_sem_down(void)
{
  int id;
  argint(0, &id);
  if (id < 0 || id >= NSEM)
    return -1;
  struct sem *s = &sems[id];

  acquire(&s->lock);
  while (s->value == 0) {
    sleep_prepare(s);	    // I will sleep on the address of s
    release(&s->lock);	    // never sleep holding a spinlock
    sleep();		    // returns at once if sem_up came in between
    acquire(&s->lock);
    if (killed(myproc())) { // kill must still work on a waiting process
      release(&s->lock);
      return -1;
    }
  }
  s->value--;
  release(&s->lock);
  return 0;
}

// sem_up(id): give one unit back and wake whoever sleeps on s.
uint64
sys_sem_up(void)
{
  int id;
  argint(0, &id);
  if (id < 0 || id >= NSEM)
    return -1;
  struct sem *s = &sems[id];

  acquire(&s->lock);
  s->value++;
  wakeup(s);
  release(&s->lock);
  return 0;
}
EOF
