import re, sys
f, anchor, new = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(f).read().split('\n')
if new.split('\n')[0] in lines:
    print(f"{f}: already there"); sys.exit(0)
for i, l in enumerate(lines):
    if re.search(anchor, l):
	lines[i+1:i+1] = new.split('\n')
	open(f, 'w').write('\n'.join(lines))
	print(f"{f}: added after line {i+1}"); sys.exit(0)
print(f"{f}: ANCHOR NOT FOUND: {anchor}"); sys.exit(1)
EOF
