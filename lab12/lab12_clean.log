7msem_t empty, full;27m
7mpthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;27m

7mvoid *producer(void *arg) {27m
7m    for (int item = 1; item <= ITEMS; item++) {27m
7m	  sem_wait(&empty);		  /* wait for a free slot */27m
7m	  pthread_mutex_lock(&lock);27m
7m	  buf[in] = item;27m
7m	  in = (in + 1) % SIZE;27m
7m	  count++;27m
7m	  printf("put %d      (in buffer: %d)\n", item, count);27m
7m	  pthread_mutex_unlock(&lock);27m
7m	  sem_post(&full);		  /* one more filled slot */27m
7m    }27m
7m    return NULL;27m
7m}27m

7mvoid *consumer(void *arg) {27m
7m    for (int k = 0; k < ITEMS; k++) {27m
7m	  sem_wait(&full);		  /* wait for something to take */27m
7m	  pthread_mutex_lock(&lock);27m
7m	  int item = buf[out];27m
7m	  out = (out + 1) % SIZE;27m
7m	  count--;27m
7m	  printf("	      take %d	(in buffer: %d)\n", item, count);27m
7m	  pthread_mutex_unlock(&lock);27m
7m	  sem_post(&empty);		  /* one more free slot */27m
7m	  usleep(300000);		  /* the consumer is slow */27m
7m    }27m
7m    return NULL;27m
7m}27m

7mint main(void) {27m
7m    sem_init(&empty, 0, SIZE);27m
7m    sem_init(&full, 0, 0);27m
7m    pthread_t p, c;27m
7m    pthread_create(&c, NULL, consumer, NULL);27m
7m    pthread_create(&p, NULL, producer, NULL);27m
7m    pthread_join(p, NULL);27m
